{
  "permissions": {
    "allow": [
      "Bash(nexus-agent:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git rev-parse:*)",
      "PowerShell(nexus-agent:*)",
      "PowerShell(dotnet build:*)",
      "PowerShell(dotnet test:*)",
      "PowerShell(git fetch:*)",
      "PowerShell(git pull:*)",
      "PowerShell(git status:*)",
      "PowerShell(git log:*)",
      "PowerShell(git rev-parse:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/scripts/claude-cs-lint.ps1\"",
            "timeout": 30,
            "statusMessage": "Linting C# change"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/scripts/claude-test-review-reminder.ps1\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
